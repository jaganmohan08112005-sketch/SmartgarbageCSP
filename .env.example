# SmartGarbage — Environment Variables

# ── Required ──────────────────────────────────────────────────────
SECRET_KEY=          # Flask session signing key (64+ random chars)
DATABASE_URL=        # Supabase Postgres pooler URI
                        # postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=        # https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Supabase service role key (for Storage + admin API)
# SUPABASE_ANON_KEY=  # Optional: use anon key for client-side, but service role is needed for server uploads

# ── Optional ──────────────────────────────────────────────────────
RENDER=              # Set "true" on Render (enables HTTPS redirect + secure cookies)
PYTHON_VERSION=3.12
FLASK_ENV=production
PORT=10000

# ── External Services (ALL OPTIONAL — free fallbacks exist) ──────
#
# Without any keys set, the app uses these FREE alternatives:
#   Twilio missing   → tracking links & OTPs sent via email (SMTP)
#   Razorpay missing → payments use UPI deep links (no gateway fees)
#   Redis missing    → background jobs run in-process (no queue server)
#   Sentry missing   → errors logged to stdout (structured JSON)
#
IOT_TELEMETRY_SECRET=    # HMAC secret for ESP32/NodeMCU bin sensors
TWILIO_ACCOUNT_SID=      # OPTIONAL: Twilio SMS/WhatsApp (fallback: email)
TWILIO_AUTH_TOKEN=       # OPTIONAL: Twilio SMS/WhatsApp (fallback: email)
TELEGRAM_BOT_TOKEN=      # OPTIONAL: Telegram bot
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartgarbage.local
RAZOR_PUBLIC_KEY=        # OPTIONAL: Razorpay payments (fallback: UPI deep links)
SENTRY_DSN=              # OPTIONAL: Error tracking (fallback: stdout logs)
# CLOUDINARY_URL=        # REMOVED: use Supabase Storage instead (free tier)

# ── Seed demo data ────────────────────────────────────────────────
# SEED_DEMO=true          # ONLY set in local dev or staging. Creates known demo accounts.
