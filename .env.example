# SmartGarbage — Environment Variables

# ── Required ──────────────────────────────────────────────────────
SECRET_KEY=          # Flask session signing key (64+ random chars)
DATABASE_URL=        # Supabase Postgres pooler URI
                        # postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=        # https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Supabase service role key (for Storage + admin API)
# SUPABASE_ANON_KEY=  # Optional: use anon key for client-side, but service role is needed for server uploads

# ── Optional ──────────────────────────────────────────────────────
RENDER=              # Set "true" on Render (enables HTTPS redirect + secure cookies)
PYTHON_VERSION=3.12
FLASK_ENV=production
PORT=10000

# ── External Services ─────────────────────────────────────────────
IOT_TELEMETRY_SECRET=    # HMAC secret for ESP32/NodeMCU bin sensors
TWILIO_ACCOUNT_SID=      # Twilio WhatsApp (optional)
TWILIO_AUTH_TOKEN=       # Twilio WhatsApp (optional)
TELEGRAM_BOT_TOKEN=      # Telegram bot token (optional)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartgarbage.local
RAZOR_PUBLIC_KEY=        # Payment gateway (optional)
SENTRY_DSN=              # Error tracking (optional)
CLOUDINARY_URL=          # Optional: Cloudinary for images (Supabase Storage preferred)

# ── Seed demo data ────────────────────────────────────────────────
# SEED_DEMO=true          # ONLY set in local dev or staging. Creates known demo accounts.
